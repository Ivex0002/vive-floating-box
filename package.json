{
  "name": "vive-floating-box",
  "version": "1.1.2",
  "description": "A React component that creates floating elements following mouse movement",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "build:watch": "tsup src/index.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "component",
    "floating",
    "animation",
    "mouse",
    "hover",
    "ui"
  ],
  "author": "garam_kim <garam199803@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ivex0002/vive-floating-box.git"
  },
  "bugs": {
    "url": "https://github.com/Ivex0002/vive-floating-box/issues"
  },
  "homepage": "https://github.com/Ivex0002/vive-floating-box#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
